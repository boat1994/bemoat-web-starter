{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "strictNullChecks": true,
    "incremental": false,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true
  },
  "include": [
    "cloudflare-env.d.ts",
    "tests/helpers/**/*.ts",
    "tests/int/**/*.int.spec.ts",
    "tests/setup/**/*.ts",
    "scripts/cli/**/*.ts",
    "scripts/context/**/*.ts",
    "scripts/handoff/**/*.ts",
    "scripts/harness-contract/**/*.ts",
    "scripts/guards/legacy-managed-state.ts",
    "vitest.config.mts",
    "vitest.setup.ts"
  ]
}
